rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // GLOBAL SECURITY HELPERS
    // ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'smarttech@gmail.com',
          'bhabanishit6@gmail.com',
          'bhabanishankarshit82@gmail.com'
        ])
      );
    }

    // ─────────────────────────────────────────────────────────────
    // DEFAULT DENY: Har unknown collection & path by default block rahega
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. COURSES:
    // Student & Visitor: Har koi course list aur price dekh sakta hai (smooth loading)
    // Hacker/Student: Koi course add/edit/delete nahi kar sakta
    // Admin: Full access to add/update/delete courses
    // ─────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 2. UNLOCKED COURSES (PII & Access Protection):
    // Student: Sirf apna khud ka unlocked document padh sakta hai.
    // Hacker Protection:
    // - Koi hacker sabhi students ki list ya email scrape nahi kar sakta (list is blocked)
    // - Koi hacker dusre student ka data ya course nahi dekh sakta (get checks email match)
    // - Koi student khud ko free course unlock nahi kar sakta (write is strictly admin-only)
    // ─────────────────────────────────────────────────────────────
    match /unlocked_courses/{email} {
      allow get: if isAdmin() || (
        isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == email.lower()
      );
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. USER PROFILES / STUDENTS (PII Protection):
    // Hacker Protection:
    // - Koi bhi hacker API se students ke phone/email ki list dump nahi kar sakta (allow list: if isAdmin())
    // - Logged-in student sirf apna khud ka profile dekh sakta hai
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student')
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          (resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower()) ||
          (resource.data.username != null && resource.data.username == request.auth.uid) ||
          studentId == request.auth.uid
        )
      );
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 4. DEMO LECTURES & CENTRE MEDIA:
    // Students & Visitors: Bina kisi error ke smooth play hoga
    // Admin: Can manage/upload videos & banners
    // ─────────────────────────────────────────────────────────────
    match /demos/{demoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 5. OFFLINE REGISTRATIONS:
    // Visitors/Students: Can submit admission seat registrations
    // Admin: Can view, verify, and manage all registrations
    // Hackers: Cannot read or scrape other students' registration forms
    // ─────────────────────────────────────────────────────────────
    match /offline_registrations/{registrationId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone']) &&
                       (!('status' in request.resource.data) || request.resource.data.status == 'Pending');
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 6. SUPPORT & HELP QUERIES:
    // Visitors/Students: Can submit helpdesk inquiries
    // Admin: Can read and manage support queries
    // Hackers: Cannot read queries sent by others
    // ─────────────────────────────────────────────────────────────
    match /support_queries/{queryId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'mobile', 'message']) &&
                       (!('status' in request.resource.data) || request.resource.data.status == 'New');
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 7. ADMINS COLLECTION:
    // Sirf verified admin hi padh sakta hai. Client-side write block hai.
    // ─────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
