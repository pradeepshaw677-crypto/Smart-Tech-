{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Educational course provided by Smart Tech",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "price": { "type": "string", "maxLength": 50 },
        "thumb": { "type": "string", "maxLength": 1000 },
        "videos": { "type": "array" }
      },
      "required": ["title", "price"]
    },
    "Demo": {
      "title": "Demo",
      "description": "Free demo lecture video",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 1000 },
        "thumbnail": { "type": "string", "maxLength": 1000 }
      },
      "required": ["title", "url"]
    },
    "UnlockedCourses": {
      "title": "UnlockedCourses",
      "description": "Student purchased course permissions",
      "type": "object",
      "properties": {
        "courses": { "type": "object" }
      }
    },
    "Asset": {
      "title": "Asset",
      "description": "Centre asset such as certificate or teacher photo",
      "type": "object",
      "properties": {
        "url": { "type": "string", "maxLength": 1000 }
      },
      "required": ["url"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Centre carousel banner image",
      "type": "object",
      "properties": {
        "url": { "type": "string", "maxLength": 1000 }
      },
      "required": ["url"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Centre gallery photo",
      "type": "object",
      "properties": {
        "url": { "type": "string", "maxLength": 1000 }
      },
      "required": ["url"]
    },
    "OfflineRegistration": {
      "title": "OfflineRegistration",
      "description": "Student admission application for offline centre",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "course": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "phone", "course"]
    },
    "SupportQuery": {
      "title": "SupportQuery",
      "description": "Customer care inquiry message",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "mobile": { "type": "string", "maxLength": 20 },
        "message": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name", "mobile", "message"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Published courses for student enrollment"
    },
    "/demos/{demoId}": {
      "schema": "Demo",
      "description": "Free demo videos available to all students"
    },
    "/unlocked_courses/{email}": {
      "schema": "UnlockedCourses",
      "description": "Mapping of student email to unlocked course IDs managed strictly by admin"
    },
    "/assets/{assetId}": {
      "schema": "Asset",
      "description": "Media assets and certificates for offline centre"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Hero carousel banners for centre display"
    },
    "/gallery/{galleryId}": {
      "schema": "Gallery",
      "description": "Photos of centre facilities and labs"
    },
    "/offline_registrations/{registrationId}": {
      "schema": "OfflineRegistration",
      "description": "Offline course seat bookings"
    },
    "/support_queries/{queryId}": {
      "schema": "SupportQuery",
      "description": "Customer care and helpdesk messages"
    }
  }
}
